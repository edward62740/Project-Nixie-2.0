/**
 * @file NTC_PCA9698.cpp
 * @brief Driver for I2C communication with PCA9698 modified for STM32 HAL
 *        using HAL_I2C_Master_Transmit/Receive.
 * @author
 */

#include "pca9698.h"

/**
 * @brief Device constructor
 * @param [in] hi2c   pointer to the initialized STM32 HAL I2C handle
 * @param [in] addr   7-bit device I2C address (e.g. 0x20, 0x21, etc.)
 */
PCA9698::PCA9698(I2C_HandleTypeDef *hi2c, uint8_t addr) {
  _hi2c = hi2c;
  _i2caddr = addr;
  _output_port0 = 0x00;
  _output_port1 = 0x00;
  _output_port2 = 0x00;
  _output_port3 = 0x00;
  _output_port4 = 0x00;
}

/**
 * @brief Configure device by writing 0x00 to configuration registers for ports 0 to 4.
 */
void PCA9698::configuration() {
  uint8_t buffer[6];
  buffer[0] = PCA9698_CONFIG_PORT0; // starting register address
  buffer[1] = 0x00;
  buffer[2] = 0x00;
  buffer[3] = 0x00;
  buffer[4] = 0x00;
  buffer[5] = 0x00;
  // Transmit the buffer (7-bit address shifted left by 1 for HAL)
  HAL_I2C_Master_Transmit(_hi2c, (_i2caddr << 1), buffer, sizeof(buffer), HAL_MAX_DELAY);
}

/**
 * @brief Write a digital value to a given PCA9698 pin.
 * @param [in] pin     PCA9698 pin number (0-39)
 * @param [in] output  Output state (HIGH or LOW)
 */
void PCA9698::digitalWrite(uint8_t pin, uint8_t output) {
  if (pin < 8) {
    if (output == HIGH) {
      _output_port0 |= (1 << pin);
    } else {
      _output_port0 &= ~(1 << pin);
    }
    writeI2c(PCA9698_OUTPUT_PORT0, _output_port0);
  } else if (pin < 16) {
    if (output == HIGH) {
      _output_port1 |= (1 << (pin - 8));
    } else {
      _output_port1 &= ~(1 << (pin - 8));
    }
    writeI2c(PCA9698_OUTPUT_PORT1, _output_port1);
  } else if (pin < 24) {
    if (output == HIGH) {
      _output_port2 |= (1 << (pin - 16));
    } else {
      _output_port2 &= ~(1 << (pin - 16));
    }
    writeI2c(PCA9698_OUTPUT_PORT2, _output_port2);
  } else if (pin < 32) {
    if (output == HIGH) {
      _output_port3 |= (1 << (pin - 24));
    } else {
      _output_port3 &= ~(1 << (pin - 24));
    }
    writeI2c(PCA9698_OUTPUT_PORT3, _output_port3);
  } else if (pin < 40) {
    if (output == HIGH) {
      _output_port4 |= (1 << (pin - 32));
    } else {
      _output_port4 &= ~(1 << (pin - 32));
    }
    writeI2c(PCA9698_OUTPUT_PORT4, _output_port4);
  }
}

/**
 * @brief Read the digital state of a given PCA9698 pin.
 * @param [in] pin  PCA9698 pin number (0-39)
 * @return HIGH if the pin is set, LOW otherwise.
 */
int PCA9698::digitalRead(uint8_t pin) {
  uint8_t data = 0;
  if (pin < 8) {
    readI2c(PCA9698_INPUT_PORT0, 1, &data);
    return (data & (1 << pin)) ? HIGH : LOW;
  } else if (pin < 16) {
    readI2c(PCA9698_INPUT_PORT1, 1, &data);
    return (data & (1 << (pin - 8))) ? HIGH : LOW;
  } else if (pin < 24) {
    readI2c(PCA9698_INPUT_PORT2, 1, &data);
    return (data & (1 << (pin - 16))) ? HIGH : LOW;
  } else if (pin < 32) {
    readI2c(PCA9698_INPUT_PORT3, 1, &data);
    return (data & (1 << (pin - 24))) ? HIGH : LOW;
  } else if (pin < 40) {
    readI2c(PCA9698_INPUT_PORT4, 1, &data);
    return (data & (1 << (pin - 32))) ? HIGH : LOW;
  }
  return LOW;
}

/**
 * @brief Reset all output pins to LOW.
 */
void PCA9698::setAllClear() {
  writeI2c(PCA9698_OUTPUT_PORT0, 0x00);
  _output_port0 = 0x00;
  writeI2c(PCA9698_OUTPUT_PORT1, 0x00);
  _output_port1 = 0x00;
  writeI2c(PCA9698_OUTPUT_PORT2, 0x00);
  _output_port2 = 0x00;
  writeI2c(PCA9698_OUTPUT_PORT3, 0x00);
  _output_port3 = 0x00;
  writeI2c(PCA9698_OUTPUT_PORT4, 0x00);
  _output_port4 = 0x00;
}

/**
 * @brief Set the direction (INPUT or OUTPUT) for an entire port.
 * @param [in] port  Port number (0-4)
 * @param [in] mode  Direction: use INPUT for input mode or OUTPUT for output mode.
 */
void PCA9698::portMode(uint8_t port, uint8_t mode) {
  if (port == 0) {
    writeI2c(PCA9698_CONFIG_PORT0, (mode == INPUT ? 0xFF : 0x00));
  } else if (port == 1) {
    writeI2c(PCA9698_CONFIG_PORT1, (mode == INPUT ? 0xFF : 0x00));
  } else if (port == 2) {
    writeI2c(PCA9698_CONFIG_PORT2, (mode == INPUT ? 0xFF : 0x00));
  } else if (port == 3) {
    writeI2c(PCA9698_CONFIG_PORT3, (mode == INPUT ? 0xFF : 0x00));
  } else if (port == 4) {
    writeI2c(PCA9698_CONFIG_PORT4, (mode == INPUT ? 0xFF : 0x00));
  }
}

/**
 * @brief Write a single byte to a specified register over I2C.
 * @param [in] address  Register address.
 * @param [in] data     Data to be written.
 */
void PCA9698::writeI2c(uint8_t address, uint8_t data) {
  uint8_t buffer[2];
  buffer[0] = address;
  buffer[1] = data;
  HAL_I2C_Master_Transmit(_hi2c, (_i2caddr << 1), buffer, sizeof(buffer), HAL_MAX_DELAY);
}

/**
 * @brief Read data from a specified register over I2C.
 * @param [in] address  Register address.
 * @param [in] num      Number of bytes to read.
 * @param [out] data    Buffer to store the read data.
 */
void PCA9698::readI2c(uint8_t address, uint8_t num, uint8_t *data) {
  // First, transmit the register address.
  HAL_I2C_Master_Transmit(_hi2c, (_i2caddr << 1), &address, 1, HAL_MAX_DELAY);
  // Then, read the requested data.
  HAL_I2C_Master_Receive(_hi2c, (_i2caddr << 1), data, num, HAL_MAX_DELAY);
}
