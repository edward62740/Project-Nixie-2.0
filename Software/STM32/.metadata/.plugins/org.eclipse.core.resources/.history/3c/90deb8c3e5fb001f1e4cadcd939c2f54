#include "main.h"
#include <app_main.h>
#include "stdint.h"

#include "pca9698.h"
#include "nixiedisplay.h"

PCA9698 bus1(&hi2c1, 0x20);
PCA9698 bus2(&hi2c1, 0x21);
bool state = 0;


uint8_t pinout1[10] = {5, 4, 3, 2, 1, 0, 9, 8, 7, 6};
uint8_t pinout2[10] = {15, 14, 13, 12, 11, 10, 27, 26, 25, 24};
uint8_t pinout3[10] = {35, 34, 31, 30, 29, 28, 39, 38, 37, 36};
uint8_t pinout4[10] = {45, 44, 43, 42, 41, 40, 49, 48, 47, 46};
uint8_t pinout5[10] = {55, 54, 53, 52, 51, 50, 67, 66, 65, 64};
uint8_t pinout6[10] = {75, 74, 71, 70, 69, 68, 79, 78, 77, 76};
NixieDisplay display(6, 0, pinout1, pinout2, pinout3, pinout4, pinout5, pinout6);

void app_main(void)
{
	HAL_GPIO_WritePin(GPIOC, GPIO_PIN_10, GPIO_PIN_RESET); //OE1
	HAL_GPIO_WritePin(GPIOC, GPIO_PIN_11, GPIO_PIN_RESET); //OE2
	HAL_Delay(5);
	bus1.configuration();

	for (int i=0;i<5;i++) bus1.portMode(i, 0x00);

	bus2.configuration();

	for (int i=0;i<5;i++) bus2.portMode(i, 0x00);

	display.init();
	display.setCrossfade(false);
}


void app_loop(void)
{

	for (int i=0; i<40; i++)
	{

		display.write((rand() % 900000) + 100000);

	}
	state = !state;
	HAL_GPIO_TogglePin(GPIOD, GPIO_PIN_1);
}



bool platformGPIOWrite(uint8_t pin, bool data)
{

  if (pin >= 40)
  {
    pin = pin - 40;
    bus2.digitalWrite(pin, data);
    return true;
  }
  else
  {
	bus1.digitalWrite(pin, data);
    return true;
  }

  return false;
}

void platformDelayMs(uint32_t ms)
{
	HAL_Delay(ms);
}
