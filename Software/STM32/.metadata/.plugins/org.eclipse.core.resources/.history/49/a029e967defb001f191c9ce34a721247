#include "PCA9698.h"

// Constructor: Save the I2C handle and device address, and initialize output caches.
PCA9698::PCA9698(I2C_HandleTypeDef *i2c_handle, uint8_t addr) {
  _hi2c = i2c_handle;
  _i2caddr = addr;
  _output_port0 = 0x00;
  _output_port1 = 0x00;
  _output_port2 = 0x00;
  _output_port3 = 0x00;
  _output_port4 = 0x00;
}

/**
 * @brief Configure the device by writing 0x00 to configuration registers of Port0 to Port4.
 * This function builds a buffer containing the register address (PCA9698_CONFIG_PORT0)
 * followed by five 0x00 bytes, and transmits it using HAL_I2C_Master_Transmit.
 */
void PCA9698::configuration() {
  // Create a buffer: first byte is the starting register, followed by 5 configuration bytes.
  uint8_t buffer[6];
  buffer[0] = PCA9698_CONFIG_PORT0;
  buffer[1] = 0x00;
  buffer[2] = 0x00;
  buffer[3] = 0x00;
  buffer[4] = 0x00;
  buffer[5] = 0x00;
  // Transmit the buffer. Note: HAL expects the 7-bit address shifted left by 1.
  HAL_I2C_Master_Transmit(_hi2c, (_i2caddr << 1), buffer, sizeof(buffer), HAL_MAX_DELAY);
}

/**
 * @brief Write to a specific GPIO pin.
 * @param pin The pin number (0-39).
 * @param output HIGH (non-zero) or LOW (zero).
 */
void PCA9698::digitalWrite(uint8_t pin, uint8_t output) {
  if(pin < 8) {
    if (output) {
      _output_port0 |= (1 << pin);
    } else {
      _output_port0 &= ~(1 << pin);
    }
    writeI2c(PCA9698_OUTPUT_PORT0, _output_port0);
  } else if(pin < 16) {
    if (output) {
      _output_port1 |= (1 << (pin - 8));
    } else {
      _output_port1 &= ~(1 << (pin - 8));
    }
    writeI2c(PCA9698_OUTPUT_PORT1, _output_port1);
  } else if(pin < 24) {
    if (output) {
      _output_port2 |= (1 << (pin - 16));
    } else {
      _output_port2 &= ~(1 << (pin - 16));
    }
    writeI2c(PCA9698_OUTPUT_PORT2, _output_port2);
  } else if(pin < 32) {
    if (output) {
      _output_port3 |= (1 << (pin - 24));
    } else {
      _output_port3 &= ~(1 << (pin - 24));
    }
    writeI2c(PCA9698_OUTPUT_PORT3, _output_port3);
  } else if(pin < 40) {
    if (output) {
      _output_port4 |= (1 << (pin - 32));
    } else {
      _output_port4 &= ~(1 << (pin - 32));
    }
    writeI2c(PCA9698_OUTPUT_PORT4, _output_port4);
  }
}

/**
 * @brief Read the state of a specific GPIO pin.
 * @param pin The pin number (0-39).
 * @return 1 if the pin is HIGH, 0 if LOW.
 */
int PCA9698::digitalRead(uint8_t pin) {
  uint8_t data = 0;
  if(pin < 8) {
    readI2c(PCA9698_INPUT_PORT0, 1, &data);
    return (data & (1 << pin)) ? 1 : 0;
  } else if(pin < 16) {
    readI2c(PCA9698_INPUT_PORT1, 1, &data);
    return (data & (1 << (pin - 8))) ? 1 : 0;
  } else if(pin < 24) {
    readI2c(PCA9698_INPUT_PORT2, 1, &data);
    return (data & (1 << (pin - 16))) ? 1 : 0;
  } else if(pin < 32) {
    readI2c(PCA9698_INPUT_PORT3, 1, &data);
    return (data & (1 << (pin - 24))) ? 1 : 0;
  } else if(pin < 40) {
    readI2c(PCA9698_INPUT_PORT4, 1, &data);
    return (data & (1 << (pin - 32))) ? 1 : 0;
  }
  return 0;
}

/**
 * @brief Set all output ports to LOW.
 */
void PCA9698::setAllClear() {
  writeI2c(PCA9698_OUTPUT_PORT0, 0x00);
  _output_port0 = 0x00;
  writeI2c(PCA9698_OUTPUT_PORT1, 0x00);
  _output_port1 = 0x00;
  writeI2c(PCA9698_OUTPUT_PORT2, 0x00);
  _output_port2 = 0x00;
  writeI2c(PCA9698_OUTPUT_PORT3, 0x00);
  _output_port3 = 0x00;
  writeI2c(PCA9698_OUTPUT_PORT4, 0x00);
  _output_port4 = 0x00;
}

/**
 * @brief Set the mode for a given port.
 * @param port The port number (0-3).
 * @param mode 0 for OUTPUT, non-zero for INPUT.
 */
void PCA9698::portMode(uint8_t port, uint8_t mode) {
  // For each port, write either 0x00 (OUTPUT) or 0xFF (INPUT)
  if(port == 0) {
    writeI2c(PCA9698_CONFIG_PORT0, (mode == 0 ? 0x00 : 0xFF));
  } else if(port == 1) {
    writeI2c(PCA9698_CONFIG_PORT1, (mode == 0 ? 0x00 : 0xFF));
  } else if(port == 2) {
    writeI2c(PCA9698_CONFIG_PORT2, (mode == 0 ? 0x00 : 0xFF));
  } else if(port == 3) {
    writeI2c(PCA9698_CONFIG_PORT3, (mode == 0 ? 0x00 : 0xFF));
  }
}

/**
 * @brief Write a single byte of data to a specified register.
 * @param reg_addr The register address.
 * @param data The data byte to write.
 *
 * This function creates a two-byte buffer: the first byte is the register address,
 * the second byte is the data. It then sends the buffer using HAL_I2C_Master_Transmit.
 */
void PCA9698::writeI2c(uint8_t reg_addr, uint8_t data) {
  uint8_t buffer[2];
  buffer[0] = reg_addr;
  buffer[1] = data;
  HAL_I2C_Master_Transmit(_hi2c, (_i2caddr << 1), buffer, sizeof(buffer), HAL_MAX_DELAY);
}

/**
 * @brief Read data from a specified register.
 * @param reg_addr The register address.
 * @param num Number of bytes to read.
 * @param data Buffer to store the read data.
 *
 * First, the register address is transmitted. Then, the data is read using HAL_I2C_Master_Receive.
 */
void PCA9698::readI2c(uint8_t reg_addr, uint8_t num, uint8_t *data) {
  // Transmit the register address
  HAL_I2C_Master_Transmit(_hi2c, (_i2caddr << 1), &reg_addr, 1, HAL_MAX_DELAY);
  // Receive the data bytes
  HAL_I2C_Master_Receive(_hi2c, (_i2caddr << 1), data, num, HAL_MAX_DELAY);
}
