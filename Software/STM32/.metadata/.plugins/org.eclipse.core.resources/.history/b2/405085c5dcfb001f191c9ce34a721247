#include "main.h"
#include <app_main.h>
#include "stdint.h"

#include "pca9698.h"

PCA9698 bus1(&hi2c1, 0x20);
PCA9698 bus2(&hi2c1, 0x21);
bool state = 0;
void app_main(void)
{

}


void app_loop(void)
{

	for (int i=0; i<40; i++)
	{
		bus1.digitalWrite(i, state);
		bus2.digitalWrite(i, state);
		state = !state;

	}
	HAL_GPIO_TogglePin(GPIOD, GPIO_PIN_1);
}
