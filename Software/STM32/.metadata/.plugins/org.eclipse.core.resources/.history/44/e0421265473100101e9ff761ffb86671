#ifndef PCF2131_H
#define PCF2131_H

#include <stdint.h>
#include <time.h>

#ifdef __cplusplus
extern "C" {
#endif

typedef enum {
    ALARM_SECOND = 0,
    ALARM_MINUTE,
    ALARM_HOUR,
    ALARM_DAY,
    ALARM_WEEKDAY
} pcf2131_alarm_setting_t;

typedef enum {
    PERIODIC_DISABLE,
    PERIODIC_EVERY_SECOND,
    PERIODIC_EVERY_MINUTE
} pcf2131_periodic_int_t;

typedef enum {
    CLOCKOUT_32768HZ = 0,
    CLOCKOUT_16384HZ,
    CLOCKOUT_8192HZ,
    CLOCKOUT_4096HZ,
    CLOCKOUT_2048HZ,
    CLOCKOUT_1024HZ,
    CLOCKOUT_1HZ,
    CLOCKOUT_DISABLED
} pcf2131_clkout_t;

// ---- Core API ----

void pcf2131_init(uint8_t i2c_addr);
void pcf2131_set_time(struct tm *t);
time_t pcf2131_get_time(void);

void pcf2131_set_alarm(pcf2131_alarm_setting_t field, int val, int int_sel);
void pcf2131_clear_alarm(void);
void pcf2131_disable_alarm(void);

uint8_t pcf2131_clear_interrupt(void);

void pcf2131_enable_periodic(pcf2131_periodic_int_t sel, int int_sel);
void pcf2131_set_clockout(pcf2131_clkout_t freq);
void pcf2131_software_reset(void);
void pcf2131_otp_refresh(void);

// ---- User-defined I2C backend ----
extern int i2c_read(uint8_t dev_addr, uint8_t reg, uint8_t *data, uint16_t len);
extern int i2c_write(uint8_t dev_addr, uint8_t reg, uint8_t *data, uint16_t len);

#ifdef __cplusplus
}
#endif
#endif
