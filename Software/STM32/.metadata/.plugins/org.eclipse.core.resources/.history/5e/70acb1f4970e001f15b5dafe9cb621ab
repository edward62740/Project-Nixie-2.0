void DBG_PRINT(void *v, char *fmt)
{
	if(!*fmt)
		fmt ="%s\n";
	snprintf(&buf, 50, *fmt, v);
	HAL_UART_Transmit(&hlpuart1, &buf, sizeof(buf), 10);
	memset(&buf, 0, 50);
}

